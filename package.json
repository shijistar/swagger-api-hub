{
  "name": "@tiny-codes/swagger-api-hub",
  "version": "1.3.1",
  "description": "Generate front-end access code for swagger backend services in one click",
  "keywords": [
    "OpenApi",
    "swagger",
    "api",
    "codegen"
  ],
  "homepage": "https://github.com/shijistar/swagger-api-hub#readme",
  "bugs": {
    "url": "https://github.com/shijistar/swagger-api-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shijistar/swagger-api-hub.git"
  },
  "license": "MIT",
  "author": "李凤宝(Leo) <shijistar@gmail.com>",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "swagger-api-hub": "bin/swagger-api-hub.js"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "cover.webp",
    "CHANGELOG.md"
  ],
  "scripts": {
    "api": "node ./bin/swagger-api-hub.js",
    "build": "father build",
    "build-storybook": "run-s task:update-docs-title task:update-stories-title task:build-storybook",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "storybook": "run-s task:update-docs-title task:update-stories-title task:storybook",
    "task:build-storybook": "storybook build",
    "task:storybook": "storybook dev -p 6006",
    "task:update-docs-title": "tsx scripts/update-docs-title.ts",
    "task:update-stories-title": "tsx scripts/update-stories-title.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "axios": "^1.15.1",
    "colors": "^1.4.0",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "lodash-es": "^4.18.1",
    "prettier": "^3.8.3",
    "signale": "^1.4.0",
    "swagger-typescript-api": "^13.6.10",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "~10.3.5",
    "@storybook/addon-links": "~10.3.5",
    "@storybook/react-vite": "~10.3.5",
    "@tiny-codes/code-style-all-in-one": "^1.1.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/signale": "^1.4.7",
    "antd": "^6.6.3",
    "father": "^4.6.10",
    "globals": "^15.15.0",
    "i18next": "^25.10.10",
    "npm-run-all2": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-syntax-highlighter": "^16.1.1",
    "storybook": "~10.3.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
